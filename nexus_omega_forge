class PythonAnalyzer(ast.NodeVisitor):
    def __init__(self, code: str, masked: str) -> None:
        self.code = code
        self.masked = masked
        self.findings: List[Finding] = []
        self.imports: List[Tuple[str, ast.AST]] = []
        self.referenced: set = set()
        self.parents: Dict[int, ast.AST] = {}
        self._stack: List[ast.AST] = []
        self.has_all = False

    def _add(self, rule_id: str, node: ast.AST, message: str,
             severity: str, cwe: Optional[str] = None) -> None:
        self.findings.append(Finding(
            rule_id=rule_id,
            engine="py-ast",
            lineno=getattr(node, "lineno", 1),
            col=getattr(node, "col_offset", 0),
            message=message,
            severity=severity,
            cwe=cwe,
        ))

    def generic_visit(self, node: ast.AST) -> None:
        if self._stack:
            self.parents[id(node)] = self._stack[-1]
        self._stack.append(node)
        super().generic_visit(node)
        self._stack.pop()

    def ancestors(self, node: ast.AST) -> List[ast.AST]:
        chain = []
        cur = self.parents.get(id(node))
        while cur is not None:
            chain.append(cur)
            cur = self.parents.get(id(cur))
        return chain

    def visit_Assign(self, node: ast.Assign) -> None:
        for target in node.targets:
            if isinstance(target, ast.Name) and target.id == "__all__":
                self.has_all = True
        self.generic_visit(node)

    def visit_Import(self, node: ast.Import) -> None:
        for alias in node.names:
            bound = alias.asname or alias.name.split(".")[0]
            self.imports.append((bound, node))
        self.generic_visit(node)

    def visit_ImportFrom(self, node: ast.ImportFrom) -> None:
        for alias in node.names:
            if alias.name == "*":
                continue
            bound = alias.asname or alias.name
            self.imports.append((bound, node))
        self.generic_visit(node)

    def visit_Name(self, node: ast.Name) -> None:
        self.referenced.add(node.id)
        self.generic_visit(node)

    def visit_Attribute(self, node: ast.Attribute) -> None:
        self.referenced.add(node.attr)
        self.generic_visit(node)

    def visit_Call(self, node: ast.Call) -> None:
        func = node.func

        if isinstance(func, ast.Name) and func.id == "eval":
            arg_desc = snippet(self.code, node.args[0]) if node.args else "?"
            self._add("py-eval", node, "eval() sur {0}".format(arg_desc), "critical", "CWE-95")

        if isinstance(func, ast.Name) and func.id == "exec":
            self._add("py-exec", node, "exec() — aucune réécriture sûre", "critical", "CWE-95")

        if isinstance(func, ast.Attribute):
            dotted = dotted_name(func)

            if dotted in ("pickle.loads", "pickle.load"):
                self._add("py-pickle", node, "désérialisation pickle", "high", "CWE-502")

            if dotted == "yaml.load":
                safe = any(kw.arg == "Loader" and "Safe" in ast.dump(kw.value) for kw in node.keywords)
                if not safe:
                    self._add("py-yaml-load", node, "yaml.load sans SafeLoader", "high", "CWE-502")

            if dotted == "os.system":
                self._add("py-os-system", node, "os.system()", "high", "CWE-78")

            if dotted.startswith("subprocess."):
                for kw in node.keywords:
                    if kw.arg == "shell" and isinstance(kw.value, ast.Constant) and kw.value.value is True:
                        self._add("py-shell-true", node, "subprocess avec shell=True", "high", "CWE-78")

            if dotted == "marshal.loads":
                self._add("py-marshal", node, "marshal.loads", "high", "CWE-502")

            if dotted in ("tempfile.mktemp",):
                self._add("py-mktemp", node, "mktemp()", "medium", "CWE-377")

        self.generic_visit(node)

    def visit_ExceptHandler(self, node: ast.ExceptHandler) -> None:
        if node.type is None:
            self._add("py-bare-except", node, "except nu", "medium", "CWE-396")
        elif node.name:
            used = any(isinstance(child, ast.Name) and child.id == node.name for stmt in node.body for child in ast.walk(stmt))
            if not used:
                self._add("py-unused-except-var", node, "variable capturée non utilisée", "low")
        self.generic_visit(node)

    def visit_Compare(self, node: ast.Compare) -> None:
        for op, comp in zip(node.ops, node.comparators):
            if isinstance(op, (ast.Eq, ast.NotEq)) and isinstance(comp, ast.Constant) and comp.value is None:
                self._add("py-none-compare", node, "== None au lieu de is None", "low", "CWE-1077")
        self.generic_visit(node)

    def visit_FunctionDef(self, node: ast.FunctionDef) -> None:
        self._check_mutable_default(node)
        self.generic_visit(node)

    def _check_mutable_default(self, node: ast.AST) -> None:
        args = getattr(node, "args", None)
        if args is None:
            return
        defaults = list(getattr(args, "defaults", [])) + [d for d in getattr(args, "kw_defaults", []) if d is not None]
        for default in defaults:
            if isinstance(default, (ast.List, ast.Dict, ast.Set)):
                self._add("py-mutable-default", default, "valeur par défaut mutable", "medium", "CWE-665")


PYTHON_FIX_RULES = [
    (r"\beval\s*\(", "ast.literal_eval(", "eval() → literal_eval", RISK_GUARDED),
    (r"\bexec\s*\(", "# REMOVED: exec()", "exec() supprimé", RISK_ADVISORY),
    (r"except\s*:", "except Exception as e:", "except nu → except Exception", RISK_SAFE),
    (r"os\.system\s*\(", "subprocess.run(", "os.system → subprocess.run", RISK_GUARDED),
    (r"shell\s*=\s*True", "shell=False", "shell=True → False", RISK_SAFE),
    (r"(?:==|!=)\s*None\b", "is None" if "==" in "" else "is not None", "=== None → is None", RISK_SAFE),
    (r"\bvar\s+", "let ", "var → let", RISK_SAFE),
    (r"\.unwrap\s*\(\s*\)", ".expect(\"safe unwrap\")", "unwrap → expect", RISK_SAFE),
]

def build_patches_from_findings(findings: List[Finding], code: str, lang: str) -> List[Patch]:
    patches = []
    masked = masked_view(code, lang)

    for f in findings:
        line = f.lineno
        if lang == "python":
            if f.rule_id == "py-bare-except":
                patches.append(Patch("bare-except", RISK_SAFE, "except nu → except Exception", (line, 0), (line, 7), "except Exception as e:", f.severity))
            if f.rule_id == "py-os-system":
                patches.append(Patch("os-system", RISK_GUARDED, "os.system → subprocess.run", (line, 0), (line, len(code.splitlines()[line-1]) if line <= len(code.splitlines()) else 0), "# TODO: remplacer par subprocess.run", f.severity, rationale="Semantique différente"))
            if f.rule_id == "py-eval":
                patches.append(Patch("eval-fix", RISK_GUARDED, "eval → literal_eval", (line, 0), (line, 100), "# WARNING: eval remplacé", f.severity, rationale="literal_eval limite aux littéraux"))
        elif lang == "javascript":
            if f.rule_id == "js-eval":
                patches.append(Patch("js-eval-fix", RISK_GUARDED, "eval → JSON.parse", (line, 0), (line, 50), "# TODO: remplacer eval par JSON.parse", f.severity))
            if f.rule_id == "js-var":
                patches.append(Patch("js-var-fix", RISK_SAFE, "var → let", (line, 0), (line, 4), "let ", f.severity))
        elif lang == "rust":
            if f.rule_id == "rs-unwrap":
                patches.append(Patch("rs-unwrap-fix", RISK_SAFE, "unwrap → expect", (line, 0), (line, 10), ".expect(\"safe\")", f.severity))

    return patches

# ═══════════════════════════════════════════════════════════════════════════
# VERIFICATEUR D'HONNETETE (GATE)
# ═══════════════════════════════════════════════════════════════════════════

def verify_patch(original: str, patched: str, lang: str, baseline_findings: List[Finding], new_findings: List[Finding], patches_applied: List[Patch]) -> Tuple[bool, str, List[Finding], List[Patch]]:
    parse_ok, parse_err = parses(patched, lang)
    if not parse_ok:
        return False, "Syntaxe invalide après patch : " + parse_err, [], []

    removed = set(f.key for f in baseline_findings if f.severity in ("critical", "high"))
    remaining_new = set(f.key for f in new_findings if f.severity in ("critical", "high"))

    regressions = removed & remaining_new
    if regressions:
        return False, "Régression détectée : {0}".format(len(regressions)), new_findings, []

    score_delta = score_for(new_findings) - score_for(baseline_findings)
    if score_delta < 0:
        return False, "Score baissé de {0}".format(-score_delta), new_findings, []

    return True, "Passe gate", new_findings, patches_applied

def score_for(findings: List[Finding]) -> int:
    critical_high = sum(SEVERITY_WEIGHT.get(f.severity, 0) for f in findings if f.severity in ("critical", "high"))
    medium_low = sum(SEVERITY_WEIGHT.get(f.severity, 0) for f in findings if f.severity in ("medium", "low"))
    return max(0, 100 - critical_high - (medium_low // 2))

def generate_manifest(outcome: Outcome) -> str:
    lines = [
        f"{MANIFEST_BEGIN}",
        f"timestamp={datetime.now(timezone.utc).isoformat()}",
        f"version={VERSION}",
        f"lang={outcome.lang}",
        f"aggression={outcome.aggression}",
        f"baseline={outcome.baseline_score}",
        f"final={outcome.final_score}",
        f"patches={len(outcome.accepted)}",
        "---",
    ]
    for p in outcome.accepted:
        lines.append(f"PATCH:{p.rule_id}:{p.line}:{p.description}")
    lines.extend(["---", f"{MANIFEST_END}"])
    return "\n".join(lines)

# ═══════════════════════════════════════════════════════════════════════════
# ORCHESTRATEUR
# ═══════════════════════════════════════════════════════════════════════════

def run_all_engines(code: str, lang: str) -> List[Finding]:
    masked = masked_view(code, lang)
    findings: List[Finding] = []

    if lang == "python":
        tree = None
        try:
            tree = ast.parse(code)
        except SyntaxError:
            pass

        analyzer = PythonAnalyzer(code, masked)
        if tree:
            analyzer.visit(tree)
        findings.extend(analyzer.findings)

    if lang in ("javascript", "typescript"):
        findings.extend(engine_js_heuristics(code, masked))

    if lang == "rust":
        findings.extend(engine_rust_heuristics(code, masked))

    if lang == "go":
        findings.extend(engine_go_heuristics(code, masked))

    secrets = detect_secrets(code)
    findings.extend(secrets)

    return findings

def compute_score(findings: List[Finding]) -> int:
    return score_for(findings)

def repair_loop(code: str, lang: str, aggression: str) -> Outcome:
    t0 = time.time()

    baseline_findings = run_all_engines(code, lang)
    baseline_score = compute_score(baseline_findings)

    patches = build_patches_from_findings(baseline_findings, code, lang)

    current = code
    accepted = []
    rejected = []
    iteration = 0

    for i in range(min(MAX_ITERATIONS, len(patches) + 1)):
        if not patches:
            break
        iteration = i + 1

        candidate = apply_patches(current, patches)

        new_findings = run_all_engines(candidate, lang)
        new_score = compute_score(new_findings)

        valid, reason, final_findings, patches_applied = verify_patch(
            current, candidate, lang, baseline_findings, new_findings, patches
        )

        if valid and new_score >= baseline_score:
            current = candidate
            accepted.extend(patches_applied)
            baseline_score = new_score
            baseline_findings = final_findings
            patches = [p for p in patches if p not in patches_applied]
        else:
            rejected.append({"patch": p.rule_id, "reason": reason})
            patches = patches[len(patches_applied):]

    final_findings = run_all_engines(current, lang)
    final_score = compute_score(final_findings)

    duration_ms = (time.time() - t0) * 1000
    manifest = generate_manifest(Outcome(lang, aggression, code, current, baseline_findings, final_findings, baseline_score, final_score, accepted, rejected, [], [], "", "", True, iteration, duration_ms))
    diff = "\n".join(difflib.unified_diff(code.splitlines(), current.splitlines(), lineterm="", n=3))

    return Outcome(
        lang=lang,
        aggression=aggression,
        original=code,
        repaired=current,
        baseline_findings=baseline_findings,
        final_findings=final_findings,
        baseline_score=baseline_score,
        final_score=final_score,
        accepted=accepted,
        rejected=rejected,
        advisories=[],
        engines=[{"name": "NEXUS OMEGA", "version": VERSION}],
        manifest=manifest,
        diff=diff,
        idempotent=True,
        iterations=iteration,
        duration_ms=duration_ms,
    )


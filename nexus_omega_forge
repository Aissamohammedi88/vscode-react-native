SECRET_PATTERNS = [
    (r"(?i)\b(password|passwd|pwd|secret|token|api_?key|access_?key|private_?key)\b\s*[:=]\s*(['\"])([^'\"]{6,})\2", "sec-assign", "secret en dur", "critical", "CWE-798"),
    (r"AKIA[0-9A-Z]{16}", "sec-aws-key", "clé AWS", "critical", "CWE-798"),
    (r"ghp_[A-Za-z0-9]{36}", "sec-gh-token", "token GitHub", "critical", "CWE-798"),
    (r"gho_[A-Za-z0-9]{36}", "sec-gh-oauth", "OAuth GitHub", "critical", "CWE-798"),
    (r"sk-[A-Za-z0-9]{48}", "sk-stripe", "clé Stripe", "critical", "CWE-798"),
    (r"-----BEGIN\s+(?:RSA|DSA|EC|PGP)?\s*PRIVATE\s+KEY-----", "sec-private-key", "clé privée", "critical", "CWE-798"),
]

def detect_secrets(code: str) -> List[Finding]:
    findings = []
    for pattern, rule_id, message, severity, cwe in SECRET_PATTERNS:
        for match in re.finditer(pattern, code):
            line, col = pos_of(code, match.start())
            findings.append(Finding(rule_id, "secrets", line, col, message, severity, cwe))
    return findings


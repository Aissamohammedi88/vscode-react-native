def engine_compile(code: str, lang: str) -> Dict[str, Any]:
    t0 = time.time()

    if lang == "python":
        try:
            compile(code, "<forge>", "exec")
            return {"ok": True, "detail": "compile() accepté",
                    "ms": round((time.time() - t0) * 1000, 2)}
        except SyntaxError as exc:
            return {"ok": False, "detail": "L{0}: {1}".format(exc.lineno, exc.msg),
                    "ms": round((time.time() - t0) * 1000, 2)}
        except (ValueError, MemoryError) as exc:
            return {"ok": False, "detail": str(exc)[:200],
                    "ms": round((time.time() - t0) * 1000, 2)}

    if lang in ("javascript", "typescript"):
        node = shutil.which("node")
        if not node:
            return {"ok": None, "detail": "node absent du système", "ms": 0.0}
        suffix = ".js" if lang == "javascript" else ".ts"
        fd, path = tempfile.mkstemp(suffix=suffix)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as fh:
                fh.write(code)
            proc = subprocess.run([node, "--check", path],
                                  capture_output=True, text=True, timeout=25)
            ok = proc.returncode == 0
            detail = "syntaxe acceptée" if ok else (proc.stderr or "erreur")[:400]
            return {"ok": ok, "detail": detail, "ms": round((time.time() - t0) * 1000, 2)}
        except (OSError, subprocess.SubprocessError) as exc:
            return {"ok": None, "detail": str(exc)[:200], "ms": 0.0}
        finally:
            try:
                os.unlink(path)
            except OSError:
                pass

    if lang == "go":
        gofmt = shutil.which("gofmt")
        if not gofmt:
            return {"ok": None, "detail": "gofmt absent du système", "ms": 0.0}
        try:
            proc = subprocess.run([gofmt, "-e"], input=code,
                                  capture_output=True, text=True, timeout=25)
            ok = proc.returncode == 0
            return {"ok": ok, "detail": ("ok" if ok else (proc.stderr or "")[:400]),
                    "ms": round((time.time() - t0) * 1000, 2)}
        except (OSError, subprocess.SubprocessError) as exc:
            return {"ok": None, "detail": str(exc)[:200], "ms": 0.0}

    return {"ok": None, "detail": "langage non couvert", "ms": 0.0}

def parses(code: str, lang: str) -> Tuple[bool, str]:
    if lang == "python":
        try:
            ast.parse(code)
            return True, ""
        except SyntaxError as exc:
            return False, "L{0}: {1}".format(exc.lineno, exc.msg)
        except (ValueError, MemoryError, RecursionError) as exc:
            return False, str(exc)[:200]

    result = engine_compile(code, lang)
    if result["ok"] is None:
        return True, "non vérifié ({0})".format(result["detail"])
    return bool(result["ok"]), result["detail"]


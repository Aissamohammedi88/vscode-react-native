def engine_js_heuristics(code: str, masked: str) -> List[Finding]:
    findings = []
    rules = [
        (r"\beval\s*\(", "js-eval", "eval()", "critical", "CWE-95"),
        (r"\.innerHTML\s*=", "js-innerhtml", "innerHTML", "high", "CWE-79"),
        (r"\bvar\s+\w", "js-var", "'var' au lieu de let/const", "low"),
        (r"new\s+Function\s*\(", "js-new-function", "new Function()", "critical", "CWE-95"),
    ]
    for pattern, rule_id, message, severity, *rest in rules:
        cwe = rest[0] if rest else None
        for match in re.finditer(pattern, masked):
            line, col = pos_of(masked, match.start())
            findings.append(Finding(rule_id, "js-heuristic", line, col, message, severity, cwe))
    return findings


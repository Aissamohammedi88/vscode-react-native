def line_starts(text: str) -> List[int]:
    starts = [0]
    for i, ch in enumerate(text):
        if ch == "\n":
            starts.append(i + 1)
    return starts

def offset_of(text: str, starts: Sequence[int], line: int, col: int) -> int:
    idx = line - 1
    if idx < 0:
        return 0
    if idx >= len(starts):
        return len(text)
    return min(starts[idx] + col, len(text))

def pos_of(text: str, offset: int) -> Tuple[int, int]:
    offset = max(0, min(offset, len(text)))
    line = text.count("\n", 0, offset) + 1
    last = text.rfind("\n", 0, offset)
    return line, offset - (last + 1)

def apply_patches(code: str, patches: Sequence[Patch]) -> str:
    starts = line_starts(code)
    ops = []
    for p in patches:
        s = offset_of(code, starts, p.start[0], p.start[1])
        e = offset_of(code, starts, p.end[0], p.end[1])
        if e < s:
            continue
        ops.append((s, e, p))

    ops.sort(key=lambda item: item[0], reverse=True)

    out = code
    boundary: Optional[int] = None
    for s, e, _p in ops:
        if boundary is not None and e > boundary:
            continue
        out = out[:s] + _p.replacement + out[e:]
        boundary = s
    return out

def _blank_grid(code: str, spans: Iterable[Tuple[int, int, int, int]]) -> str:
    rows = code.splitlines()
    grid = [list(r) for r in rows]
    for (sr, sc, er, ec) in spans:
        for r in range(sr, er + 1):
            if r < 0 or r >= len(grid):
                continue
            row = grid[r]
            start = sc if r == sr else 0
            end = ec if r == er else len(row)
            for c in range(max(0, start), min(end, len(row))):
                if row[c] != "\t":
                    row[c] = " "
    return "\n".join("".join(r) for r in grid)

def blank_python_noise(code: str) -> str:
    try:
        toks = list(tokenize.generate_tokens(io.StringIO(code).readline))
    except (tokenize.TokenError, IndentationError, SyntaxError, ValueError):
        return code
    spans = []
    for tok in toks:
        if tok.type in (tokenize.STRING, tokenize.COMMENT):
            spans.append((tok.start[0] - 1, tok.start[1], tok.end[0] - 1, tok.end[1]))
    return _blank_grid(code, spans)

def blank_clike_noise(code: str) -> str:
    spans = []
    i = 0
    n = len(code)
    line = 0
    col = 0

    def advance(count: int = 1) -> None:
        nonlocal i, line, col
        for _ in range(count):
            if i >= n:
                return
            if code[i] == "\n":
                line += 1
                col = 0
            else:
                col += 1
            i += 1

    while i < n:
        ch = code[i]

        if ch == "/" and i + 1 < n and code[i + 1] == "/":
            sl, sc = line, col
            while i < n and code[i] != "\n":
                advance()
            spans.append((sl, sc, line, col))
            continue

        if ch == "/" and i + 1 < n and code[i + 1] == "*":
            sl, sc = line, col
            advance(2)
            while i < n and not (code[i] == "*" and i + 1 < n and code[i + 1] == "/"):
                advance()
            advance(2)
            spans.append((sl, sc, line, col))
            continue

        if ch in ('"', "'", "`"):
            quote = ch
            sl, sc = line, col
            advance()
            while i < n:
                if code[i] == "\\":
                    advance(2)
                    continue
                if code[i] == quote:
                    advance()
                    break
                if code[i] == "\n" and quote != "`":
                    break
                advance()
            spans.append((sl, sc, line, col))
            continue

        advance()

    return _blank_grid(code, spans)

def masked_view(code: str, lang: str) -> str:
    if lang == "python":
        return blank_python_noise(code)
    return blank_clike_noise(code)

def dotted_name(node: ast.AST) -> str:
    parts = []
    cur = node
    while isinstance(cur, ast.Attribute):
        parts.append(cur.attr)
        cur = cur.value
    if isinstance(cur, ast.Name):
        parts.append(cur.id)
    else:
        return ""
    return ".".join(reversed(parts))

def snippet(code: str, node: ast.AST, limit: int = 58) -> str:
    try:
        seg = ast.get_source_segment(code, node)
    except (AttributeError, TypeError):
        seg = None
    if not seg:
        return "?"
    seg = " ".join(seg.split())
    return seg if len(seg) <= limit else seg[: limit - 3] + "..."


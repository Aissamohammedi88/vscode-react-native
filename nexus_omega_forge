@dataclass(frozen=True)
class Finding:
    rule_id: str
    engine: str
    lineno: int
    col: int
    message: str
    severity: str
    cwe: Optional[str] = None

    @property
    def key(self) -> str:
        return "{0}@{1}:{2}".format(self.rule_id, self.lineno, self.col)

    def to_dict(self) -> Dict[str, Any]:
        return {
            "rule_id": self.rule_id,
            "engine": self.engine,
            "lineno": self.lineno,
            "col": self.col,
            "message": self.message,
            "severity": self.severity,
            "cwe": self.cwe,
        }

@dataclass
class Patch:
    rule_id: str
    risk: str
    description: str
    start: Tuple[int, int]
    end: Tuple[int, int]
    replacement: str
    severity: str = "medium"
    rationale: str = ""

    def to_dict(self) -> Dict[str, Any]:
        return {
            "rule_id": self.rule_id,
            "risk": self.risk,
            "description": self.description,
            "line": self.start[0],
            "rationale": self.rationale,
        }


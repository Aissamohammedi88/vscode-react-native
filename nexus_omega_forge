# ═══════════════════════════════════════════════════════════════════════════

def find_free_port(start: int = DEFAULT_PORT, end: int = DEFAULT_PORT + 100) -> int:
    for port in range(start, end + 1):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.bind(('0.0.0.0', port))
            s.close()
            return port
        except OSError:
            continue
    return start + int.from_bytes(os.urandom(2), 'big') % 1000

